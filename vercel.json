{
  "version": 2,
  "outputDirectory": "site",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/login.html"
    }
  ]
}
